{
  "installCommand": "npm run install:all",
  "buildCommand": "npm run build --prefix client",
  "outputDirectory": "client/dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index?route=/:path*" },
    { "source": "/((?!api(?:/|$)).*)", "destination": "/index.html" }
  ]
}
